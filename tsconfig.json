{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["tests/golden.test.ts"],
  "exclude": ["tests/.golden-*"]
}
